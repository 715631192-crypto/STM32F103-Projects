<Slide>
  <Box style={{ width: '1280px', height: '720px', background: '#0B1120', padding: '20px 64px', display: 'flex', flexDirection: 'column' }}>
    {/* A 标题块 */}
    <Box style={{ height: 80, display: 'flex', flexDirection: 'column', justifyContent: 'center', borderBottom: '2px solid rgba(59,130,246,0.3)' }}>
      <Text style={{ fontSize: 15, color: '#06B6D4', fontWeight: 'bold', letterSpacing: 2 }}>第 4 章 · 动作组</Text>
      <Text style={{ fontSize: 34, color: '#E2E8F0', fontWeight: 'bold', marginTop: 4 }}>do_group_once 与 getMaxTime</Text>
    </Box>
    {/* B 内容区：左代码 + 右说明 */}
    <Box style={{ flex: 1, marginTop: 10, display: 'flex', flexDirection: 'row', gap: 28 }}>
      <Box style={{ width: 600 }}>
        <CodeBlock
          code={`/* 执行第 group_num 组一次 */
void do_group_once(int group_num)
{
    spiFlashOn(1); Delay_ms(10);
    memset(uart_receive_buf, 0, sizeof(uart_receive_buf));
    w25x_read(uart_receive_buf,
              group_num * ACTION_SIZE, ACTION_SIZE); // 从Flash读
    action_time = getMaxTime(uart_receive_buf);      // 本组最大T
    parse_action(uart_receive_buf);                  // 交回指令解析
    spiFlashOn(0);
}

/* 取出本组最长执行时间 */
int getMaxTime(u8* str)
{
    while (str[i]) {
        if (str[i]=='T') {
            int j=i+1, tmp=0;
            while (str[j] && str[j]!='!' && isdigit)
                tmp = tmp*10 + (str[j++]-'0'); // 逐位读
            if (tmp > max) max = tmp;
            i = j;
        } else i++;
    }
    return max;
}`}
          language='c'
          width={600}
          fontSize={12}
        />
      </Box>
      <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
        <Box style={{ background: 'rgba(59,130,246,0.08)', borderRadius: 8, padding: '12px 16px' }}>
          <Text style={{ fontSize: 17, color: '#CBD5E1', lineHeight: 1.55 }}>
            <span style={{ color: '#3B82F6', fontWeight: 'bold' }}>do_group_once</span>：开 Flash → 按组号读 256 字节 → 算本组时长 → 交给 <span style={{ color: '#06B6D4' }}>parse_action</span> 执行 → 关 Flash。
          </Text>
        </Box>
        <Box style={{ background: 'rgba(6,182,212,0.08)', borderRadius: 8, padding: '12px 16px' }}>
          <Text style={{ fontSize: 17, color: '#CBD5E1', lineHeight: 1.55 }}>
            <span style={{ color: '#06B6D4', fontWeight: 'bold' }}>getMaxTime</span> 决定「这组播多久」：取组内所有 <span style={{ color: '#06B6D4' }}>T</span> 的最大值，loop_action 据此等够时间再播下一组。
          </Text>
        </Box>
        <Box style={{ background: 'rgba(251,191,36,0.08)', borderRadius: 8, padding: '12px 16px', borderLeft: '4px solid #FBBF24' }}>
          <Text style={{ fontSize: 15, color: '#E2E8F0', lineHeight: 1.5 }}>
            ✅ 已修复：旧代码固定读 T 后 4 位，遇到 3 位 T（如 T500）会误读 <span style={{ color: '#FBBF24' }}>!</span> 算成负数。现改为「逐位读到 ! 或非数字」，兼容任意长度。
          </Text>
        </Box>
      </Box>
    </Box>
    {/* C 页脚 */}
    <Box style={{ height: 40, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>六轴机械臂代码详解</Text>
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>30 / 41</Text>
    </Box>
  </Box>
</Slide>
