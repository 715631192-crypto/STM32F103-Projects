<Slide>
  <Box style={{ width: '1280px', height: '720px', background: '#0B1120', padding: '20px 64px', display: 'flex', flexDirection: 'column' }}>
    {/* A 标题块 */}
    <Box style={{ height: 88, display: 'flex', flexDirection: 'column', justifyContent: 'center', borderBottom: '2px solid rgba(59,130,246,0.3)' }}>
      <Text style={{ fontSize: 15, color: '#06B6D4', fontWeight: 'bold', letterSpacing: 2 }}>第 1 章 · 系统全景</Text>
      <Text style={{ fontSize: 32, color: '#E2E8F0', fontWeight: 'bold', marginTop: 4 }}>一条数据主线（全系统的「总线」）</Text>
    </Box>
    {/* B 内容区：上 SVG 大图 + 下注解 */}
    <Box style={{ flex: 1, marginTop: 12, display: 'flex', flexDirection: 'column', gap: 12 }}>
      <Box style={{ background: '#0F172A', borderRadius: 10, padding: '10px 12px' }}>
        <svg width='1152' height='320' viewBox='0 0 1152 320' style={{ display: 'block' }}>
          {/* 节点样式色 */}
          <defs>
            <linearGradient id='bh' x1='0' y1='0' x2='1' y2='0'>
              <stop offset='0%' stopColor='#3B82F6' /><stop offset='100%' stopColor='#06B6D4' />
            </linearGradient>
          </defs>
          {/* 输入源 */}
          <rect x='10' y='120' width='150' height='80' rx='8' fill='#1E293B' stroke='#3B82F6' strokeWidth='2' />
          <text x='85' y='150' fill='#E2E8F0' fontSize='17' textAnchor='middle' fontWeight='bold'>串口助手</text>
          <text x='85' y='176' fill='#94A3B8' fontSize='14' textAnchor='middle'>USART1</text>
          <rect x='10' y='220' width='150' height='80' rx='8' fill='#1E293B' stroke='#3B82F6' strokeWidth='2' />
          <text x='85' y='250' fill='#E2E8F0' fontSize='17' textAnchor='middle' fontWeight='bold'>PS2 手柄</text>
          <text x='85' y='276' fill='#94A3B8' fontSize='14' textAnchor='middle'>按键注入</text>
          {/* 箭头到主线 */}
          <path d='M160 160 H250' stroke='#64748B' strokeWidth='2' markerEnd='url(#ar)' />
          <path d='M160 260 H250' stroke='#64748B' strokeWidth='2' markerEnd='url(#ar)' />
          {/* 主线缓冲 */}
          <rect x='250' y='150' width='230' height='100' rx='8' fill='#0B1120' stroke='url(#bh)' strokeWidth='3' />
          <text x='365' y='185' fill='#FBBF24' fontSize='16' textAnchor='middle' fontWeight='bold'>uart_receive_buf</text>
          <text x='365' y='210' fill='#94A3B8' fontSize='14' textAnchor='middle'>+ uart1_mode</text>
          <text x='365' y='232' fill='#94A3B8' fontSize='14' textAnchor='middle'>+ uart1_get_ok</text>
          {/* 箭头到分发 */}
          <path d='M480 200 H560' stroke='#64748B' strokeWidth='2' markerEnd='url(#ar)' />
          {/* 分发器 */}
          <rect x='560' y='150' width='200' height='100' rx='8' fill='#1E293B' stroke='#3B82F6' strokeWidth='2' />
          <text x='660' y='195' fill='#E2E8F0' fontSize='17' textAnchor='middle' fontWeight='bold'>app_usart_run()</text>
          <text x='660' y='222' fill='#06B6D4' fontSize='14' textAnchor='middle'>按 mode 分发</text>
          {/* 箭头到 5 函数 */}
          <path d='M760 180 H840' stroke='#64748B' strokeWidth='2' markerEnd='url(#ar)' />
          {/* 解析函数列 */}
          <g fontSize='14' fill='#E2E8F0'>
            <rect x='840' y='20' width='300' height='40' rx='6' fill='#1E293B' stroke='#3B82F6' strokeWidth='1.5' />
            <text x='990' y='45' textAnchor='middle'>parse_cmd   ($ 系统命令)</text>
            <rect x='840' y='70' width='300' height='40' rx='6' fill='#1E293B' stroke='#3B82F6' strokeWidth='1.5' />
            <text x='990' y='95' textAnchor='middle'>parse_action (# 舵机移动)</text>
            <rect x='840' y='120' width='300' height='40' rx='6' fill='#1E293B' stroke='#3B82F6' strokeWidth='1.5' />
            <text x='990' y='145' textAnchor='middle'>parse_angle  (S 角度模式)</text>
            <rect x='840' y='170' width='300' height='40' rx='6' fill='#1E293B' stroke='#3B82F6' strokeWidth='1.5' />
            <text x='990' y='195' textAnchor='middle'>save_action  (&lt; 存 Flash)</text>
            <rect x='840' y='220' width='300' height='40' rx='6' fill='#1E293B' stroke='#3B82F6' strokeWidth='1.5' />
            <text x='990' y='245' textAnchor='middle'>loop_action  (动作组播放)</text>
          </g>
          {/* 箭头汇总到执行 */}
          <path d='M840 240 H700 V320 H420' fill='none' stroke='#64748B' strokeWidth='2' markerEnd='url(#ar)' />
          <rect x='250' y='290' width='170' height='22' rx='4' fill='#0B1120' stroke='#FBBF24' strokeWidth='1.5' />
          <text x='335' y='306' fill='#FBBF24' fontSize='13' textAnchor='middle'>PWM 0~5 (TIM2)</text>
          <rect x='430' y='290' width='190' height='22' rx='4' fill='#0B1120' stroke='#FBBF24' strokeWidth='1.5' />
          <text x='525' y='306' fill='#FBBF24' fontSize='13' textAnchor='middle'>总线舵机 (USART3)</text>
          <defs>
            <marker id='ar' markerWidth='10' markerHeight='10' refX='8' refY='3' orient='auto'>
              <path d='M0,0 L8,3 L0,6 Z' fill='#64748B' />
            </marker>
          </defs>
        </svg>
      </Box>
      <Box style={{ display: 'flex', flexDirection: 'row', gap: 16 }}>
        <Box style={{ flex: 1, background: 'rgba(59,130,246,0.08)', borderRadius: 8, padding: '12px 16px' }}>
          <Text style={{ fontSize: 17, color: '#E2E8F0', lineHeight: 1.55 }}>
            <span style={{ color: '#FBBF24', fontWeight: 'bold' }}>数据主线</span>：串口和手柄都把指令写进 <span style={{ color: '#06B6D4' }}>uart_receive_buf</span>，并置 <span style={{ color: '#06B6D4' }}>uart1_mode</span>（指令类型）与 <span style={{ color: '#06B6D4' }}>uart1_get_ok</span>（收完标志）。
          </Text>
        </Box>
        <Box style={{ flex: 1, background: 'rgba(6,182,212,0.08)', borderRadius: 8, padding: '12px 16px' }}>
          <Text style={{ fontSize: 17, color: '#E2E8F0', lineHeight: 1.55 }}>
            <span style={{ color: '#FBBF24', fontWeight: 'bold' }}>统一出口</span>：无论来源，一律经 <span style={{ color: '#06B6D4' }}>app_usart_run()</span> 分发——这就是为什么手柄无需单独写一套舵机驱动。
          </Text>
        </Box>
      </Box>
    </Box>
    {/* C 页脚 */}
    <Box style={{ height: 40, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>六轴机械臂代码详解</Text>
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>05 / 41</Text>
    </Box>
  </Box>
</Slide>
