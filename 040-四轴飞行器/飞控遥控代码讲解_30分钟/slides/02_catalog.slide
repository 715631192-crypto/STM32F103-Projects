<Slide style={{ width: '1280px', height: '720px', background: '#0A1626' }}>
  <Box style={{ height: 120, padding: '24px 64px', borderBottom: '1px solid #1E3A5F' }}>
    <Text style={{ fontSize: 34, fontWeight: 500, color: '#E8F0FA' }}>讲解顺序与时间分配</Text>
    <Text style={{ fontSize: 16, color: '#9DB4CE', marginTop: 6 }}>主线：飞控 main → 遥控 main → 双向通信桥接，共约 30 分钟</Text>
  </Box>
  <Box style={{ height: 540, padding: '10px 64px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
    {[['0','总览：对称架构 + 轮询调度心智模型','2'],
      ['1','飞控 main() 与 ALL_Init() 外设初始化','4.5'],
      ['2','飞控时间片调度器 main_loop','1.5'],
      ['3','★ Duty_2ms 控制闭环（MpuGetData→FlightPidControl→MotorControl）','4.5'],
      ['4','Duty_6ms 姿态解算 GetAngle','2'],
      ['5','Duty_4ms 通信与解锁','3'],
      ['6','Duty_10ms 光流 + 高度','2'],
      ['7','Duty_20/50/1000ms 慢速档（简述）','1'],
      ['8','遥控 main() 与初始化','1.5'],
      ['9','遥控时间片调度器 ANO_Loop','1.5'],
      ['10','★ ANO_Loop_500Hz 摇杆采集 ANO_Stick_Scan','2.5'],
      ['11','ANO_Loop_250Hz 发送控制 ANO_DT_Send_RCData','1.5'],
      ['12','遥控其余档（简述）','0.5'],
      ['13','飞控 ↔ 遥控 通信桥接','2.5'],
      ['14','收尾 + 已知问题提示','1.5']].map((r,i)=>(
      <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', background: i%2? '#0F1E33':'transparent', padding: '5px 16px', borderRadius: 6 }}>
        <Text style={{ fontSize: 15, color: '#00D1FF', fontWeight: 700, width: 48 }}>{r[0]}</Text>
        <Text style={{ fontSize: 16, color: (r[0]==='3'||r[0]==='10')? '#E8F0FA':'#C7D6E8', fontWeight: (r[0]==='3'||r[0]==='10')?700:400, flex: 1 }}>{r[1]}</Text>
        <Text style={{ fontSize: 16, color: '#4A90D9', fontWeight: 700, width: 70, textAlign: 'right' }}>{r[2]}′</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ height: 60, padding: '0 64px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>飞控+遥控 代码讲解（30min）</Text>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>02 / 22</Text>
  </Box>
</Slide>
