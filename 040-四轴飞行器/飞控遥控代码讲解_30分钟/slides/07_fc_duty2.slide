<Slide style={{ width: '1280px', height: '720px', background: '#0A1626' }}>
  <Box style={{ height: 120, padding: '24px 64px', borderBottom: '1px solid #1E3A5F' }}>
    <Text style={{ fontSize: 34, fontWeight: 500, color: '#E8F0FA' }}>第 3 章① · Duty_2ms 控制闭环 ★全场重点</Text>
    <Text style={{ fontSize: 16, color: '#9DB4CE', marginTop: 6 }}>文件：USER/scheduler.c:77 — 每个 2ms 跑一次，是飞行器"自稳"的真正心脏</Text>
  </Box>
  <Box style={{ height: 540, padding: '22px 64px', flexDirection: 'column', justifyContent: 'center', gap: 16 }}>
    {[['MpuGetData()','HARDWARE/mpu6050.c','读 12 字节原始值，减零偏，加速度计卡尔曼 / 陀螺仪低通滤波'],
      ['FlightPidControl(0.002f)','HAL/control.c','状态机 PROCESS_31：外环角度 × 内环角速度串级 PID，输出姿态控制量'],
      ['MotorControl()','HAL/control.c','姿态 PID 输出 + 油门，按 X 型四轴映射到 4 路电机 PWM']].map((d,i)=>(
      <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', background: '#0F1E33', padding: '16px 22px', borderRadius: 10, borderLeft: '4px solid #00D1FF' }}>
        <Text style={{ fontSize: 22, color: '#00D1FF', fontWeight: 700, fontFamily: 'monospace', width: 340 }}>{d[0]}</Text>
        <Text style={{ fontSize: 15, color: '#7E94AE', width: 220, fontFamily: 'monospace' }}>{d[1]}</Text>
        <Text style={{ fontSize: 17, color: '#C7D6E8', flex: 1, lineHeight: 1.45 }}>{d[2]}</Text>
      </Box>
    ))}
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 18, marginTop: 4 }}>
      <Text style={{ fontSize: 26, color: '#4A90D9', fontWeight: 700 }}>采样</Text>
      <Text style={{ fontSize: 26, color: '#7E94AE' }}>→</Text>
      <Text style={{ fontSize: 26, color: '#4A90D9', fontWeight: 700 }}>控制</Text>
      <Text style={{ fontSize: 26, color: '#7E94AE' }}>→</Text>
      <Text style={{ fontSize: 26, color: '#4A90D9', fontWeight: 700 }}>执行</Text>
    </Box>
  </Box>
  <Box style={{ height: 60, padding: '0 64px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>飞控+遥控 代码讲解（30min）</Text>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>07 / 22</Text>
  </Box>
</Slide>
