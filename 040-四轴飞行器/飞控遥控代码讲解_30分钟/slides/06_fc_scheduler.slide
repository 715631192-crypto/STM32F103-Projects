<Slide style={{ width: '1280px', height: '720px', background: '#0A1626' }}>
  <Box style={{ height: 120, padding: '24px 64px', borderBottom: '1px solid #1E3A5F' }}>
    <Text style={{ fontSize: 34, fontWeight: 500, color: '#E8F0FA' }}>第 2 章 · 飞控时间片调度器</Text>
    <Text style={{ fontSize: 16, color: '#9DB4CE', marginTop: 6 }}>文件：USER/scheduler.c · Loop_check()/main_loop() — 1ms tick 分发到各档</Text>
  </Box>
  <Box style={{ height: 540, padding: '24px 64px', flexDirection: 'column', justifyContent: 'center', gap: 18 }}>
    <svg width='1152' height='340' viewBox='0 0 1152 340'>
      <line x1='60' y1='210' x2='1110' y2='210' stroke='#1E3A5F' strokeWidth='2'/>
      {[['2ms',90,'MpuGetData+PID+电机',300],['4ms',242,'NRF/解锁',252],['6ms',394,'GetAngle解算',200],['10ms',546,'光流+高度',152],['20ms',698,'上位机',104],['50ms',850,'LED/电压',72],['1000ms',1002,'信号统计',40]].map((d,i)=>{
        const x=d[1]; const barTop=210-d[3];
        return (<g key={i}>
          <line x1={x} y1={barTop} x2={x} y2='210' stroke={i===0?'#00D1FF':'#4A90D9'} strokeWidth='3'/>
          <circle cx={x} cy={barTop} r='9' fill={i===0?'#00D1FF':'#4A90D9'}/>
          <text x={x} y={barTop-16} fill={i===0?'#00D1FF':'#4A90D9'} fontSize='19' fontWeight='700' textAnchor='middle' fontFamily='sans-serif'>{d[0]}</text>
          <text x={x} y='238' fill='#9DB4CE' fontSize='13' textAnchor='middle' fontFamily='sans-serif'>{d[2]}</text>
        </g>);
      })}
    </svg>
    <Box style={{ flexDirection: 'row', gap: 24, justifyContent: 'center' }}>
      <Box style={{ background: '#0F1E33', borderLeft: '4px solid #00D1FF', padding: '14px 22px', borderRadius: 8, width: '48%' }}>
        <Text style={{ fontSize: 18, color: '#E8F0FA', lineHeight: 1.5 }}>
          <span style={{ color: '#00D1FF', fontWeight: 700 }}>2ms 是姿态心跳</span>：采 MPU6050 → 跑姿态 PID → 更新电机，三者同档保证闭环最新鲜。
        </Text>
      </Box>
      <Box style={{ background: '#0F1E33', borderLeft: '4px solid #4A90D9', padding: '14px 22px', borderRadius: 8, width: '48%' }}>
        <Text style={{ fontSize: 18, color: '#E8F0FA', lineHeight: 1.5 }}>
          <span style={{ color: '#4A90D9', fontWeight: 700 }}>慢任务降频</span>：解算 6ms、高度 10ms、上位机 20ms、LED/电压 50ms、统计 1s——不挤占实时控制。
        </Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 60, padding: '0 64px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>飞控+遥控 代码讲解（30min）</Text>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>06 / 22</Text>
  </Box>
</Slide>
