<Slide style={{ width: '1280px', height: '720px', background: '#0A1626' }}>
  <Box style={{ height: 120, padding: '24px 64px', borderBottom: '1px solid #1E3A5F' }}>
    <Text style={{ fontSize: 34, fontWeight: 500, color: '#E8F0FA' }}>第 13 章② · 通信桥接 · 回传 + 帧格式</Text>
    <Text style={{ fontSize: 16, color: '#9DB4CE', marginTop: 6 }}>飞机→手柄：姿态/电压回传，OLED 显示；两张帧格式对照收尾</Text>
  </Box>
  <Box style={{ height: 540, padding: '18px 64px', flexDirection: 'row', gap: 36 }}>
    <Box style={{ width: '46%', flexDirection: 'column', justifyContent: 'center', gap: 10 }}>
      <Text style={{ fontSize: 16, color: '#00D1FF', fontWeight: 700, fontFamily: 'monospace' }}>飞控 ANO_DT_Data_Exchange()</Text>
      <Text style={{ fontSize: 15, color: '#9DB4CE' }}>AA AA 01 姿态 / AA AA 05 电压</Text>
      <Text style={{ fontSize: 22, color: '#7E94AE', marginLeft: 8 }}>↓ 2.4G 无线</Text>
      <Text style={{ fontSize: 16, color: '#4A90D9', fontWeight: 700, fontFamily: 'monospace' }}>遥控 ANO_NRF_Check_Event() 收</Text>
      <Text style={{ fontSize: 22, color: '#7E94AE', marginLeft: 8 }}>↓</Text>
      <Text style={{ fontSize: 16, color: '#4A90D9', fontWeight: 700, fontFamily: 'monospace' }}>ANO_DT_NrfData_Anl() 解析</Text>
      <Text style={{ fontSize: 22, color: '#7E94AE', marginLeft: 8 }}>↓</Text>
      <Text style={{ fontSize: 16, color: '#E8F0FA', fontWeight: 700 }}>OLED 显示 Show.X/Y/Z/H、电压、模式</Text>
    </Box>
    <Box style={{ width: '50%', flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
      <Text style={{ fontSize: 17, color: '#9DB4CE', marginBottom: 4 }}>帧格式对照表</Text>
      {[['方向','帧头','功能','内容'],
        ['遥控→飞控','AA AF','03','THR/YAW/ROL/PIT/AUX'],
        ['飞控→遥控','AA AA','01','姿态角 roll/pitch/yaw + 高度'],
        ['飞控→遥控','AA AA','05','电压/硬件类型/传感器状态/模式']].map((r,i)=>(
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', background: i===0? '#1E3A5F':'#0F1E33', padding: '10px 14px', borderRadius: 6 }}>
          <Text style={{ fontSize: 15, color: i===0? '#00D1FF':'#C7D6E8', fontWeight: i===0?700:400, width: 130 }}>{r[0]}</Text>
          <Text style={{ fontSize: 15, color: '#4A90D9', fontFamily: 'monospace', width: 90 }}>{r[1]}</Text>
          <Text style={{ fontSize: 15, color: '#4A90D9', fontFamily: 'monospace', width: 50 }}>{r[2]}</Text>
          <Text style={{ fontSize: 14, color: '#9DB4CE', flex: 1 }}>{r[3]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ height: 60, padding: '0 64px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>飞控+遥控 代码讲解（30min）</Text>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>20 / 22</Text>
  </Box>
</Slide>
