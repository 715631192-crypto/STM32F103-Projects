<Slide style={{ width: '1280px', height: '720px', background: '#0A1626' }}>
  <Box style={{ height: 120, padding: '24px 64px', borderBottom: '1px solid #1E3A5F' }}>
    <Text style={{ fontSize: 34, fontWeight: 500, color: '#E8F0FA' }}>第 5 章 · Duty_4ms 通信与解锁</Text>
    <Text style={{ fontSize: 16, color: '#9DB4CE', marginTop: 6 }}>文件：USER/scheduler.c:88 — 飞控的"接收端"：收指令、回遥测、解通道、判解锁</Text>
  </Box>
  <Box style={{ height: 540, padding: '20px 64px', flexDirection: 'column', justifyContent: 'center', gap: 14 }}>
    {[['ANO_NRF_Check_Event()','收 2.4G 遥控数据（NRF 中断收包）'],
      ['ANO_DT_Data_Exchange()','回传飞机数据到遥控（HAL/ANO_Data_Transfer.c）：AA AA 01 姿态 / 05 电压'],
      ['Rc_Connect()','解析通道值；成功分支为空 {}（已知软性预留）'],
      ['Mode_Controler(0.004f)','飞行模式选择 + 解锁判断']].map((d,i)=>(
      <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', background: '#0F1E33', padding: '14px 22px', borderRadius: 8, borderLeft: '4px solid #4A90D9' }}>
        <Text style={{ fontSize: 20, color: '#E8F0FA', fontFamily: 'monospace', fontWeight: 600, width: 360 }}>{d[0]}</Text>
        <Text style={{ fontSize: 17, color: '#9DB4CE', flex: 1, lineHeight: 1.45 }}>{d[1]}</Text>
      </Box>
    ))}
    <Box style={{ background: '#0F1E33', borderLeft: '4px solid #00D1FF', padding: '12px 20px', borderRadius: 8, marginTop: 4 }}>
      <Text style={{ fontSize: 17, color: '#E8F0FA', lineHeight: 1.5 }}>
        本段与第 11 段遥控发送端、第 13 段桥接呼应：<span style={{ color: '#00D1FF', fontWeight: 700 }}>遥控发 → 飞控此处收</span>。
      </Text>
    </Box>
  </Box>
  <Box style={{ height: 60, padding: '0 64px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>飞控+遥控 代码讲解（30min）</Text>
