<Slide style={{ width: '1280px', height: '720px', background: '#0A1626' }}>
  <Box style={{ height: 120, padding: '24px 64px', borderBottom: '1px solid #1E3A5F' }}>
    <Text style={{ fontSize: 34, fontWeight: 500, color: '#E8F0FA' }}>第 10 章② · ANO_Stick_Scan 六步流程</Text>
    <Text style={{ fontSize: 16, color: '#9DB4CE', marginTop: 6 }}>从原始 ADC 到干净通道值：人机交互的"净化"全过程</Text>
  </Box>
  <Box style={{ height: 540, padding: '24px 64px', flexDirection: 'column', justifyContent: 'center', gap: 14 }}>
    <svg width='1152' height='250' viewBox='0 0 1152 250'>
      {[['①','ADC 读值','4路模拟量'],['②','比例换算','×0.25 - 偏置'],['③','滑动滤波','Window_Filter'],['④','中点校准','Mid_Offset'],['⑤','输出限幅','1000~2000'],['⑥','中点死区','±10 归中']].map((d,i)=>{
        const x=40+i*185;
        return (<g key={i}>
          <rect x={x} y='70' width='150' height='90' rx='12' fill={i%2?'#0F1E33':'#13243C'} stroke='#00D1FF' strokeWidth='2'/>
          <text x={x+75} y='108' fill='#00D1FF' fontSize='22' fontWeight='700' textAnchor='middle' fontFamily='sans-serif'>{d[0]}</text>
          <text x={x+75} y='134' fill='#E8F0FA' fontSize='15' fontWeight='700' textAnchor='middle' fontFamily='sans-serif'>{d[1]}</text>
          <text x={x+75} y='152' fill='#9DB4CE' fontSize='11' textAnchor='middle' fontFamily='sans-serif'>{d[2]}</text>
          {i<5 && <text x={x+167} y='118' fill='#4A90D9' fontSize='26' fontWeight='700' textAnchor='middle' fontFamily='sans-serif'>→</text>}
        </g>);
      })}
      <text x='576' y='210' fill='#7E94AE' fontSize='14' textAnchor='middle' fontFamily='sans-serif'>滤波+校准+限幅+死区 = 遥控输入"四件套"，保证手柄数据干净稳定</text>
    </svg>
    <Box style={{ flexDirection: 'row', gap: 24, justifyContent: 'center' }}>
      <Box style={{ background: '#0F1E33', borderLeft: '4px solid #00D1FF', padding: '12px 20px', borderRadius: 8, width: '48%' }}>
        <Text style={{ fontSize: 17, color: '#E8F0FA', lineHeight: 1.5 }}>
          <span style={{ color: '#00D1FF', fontWeight: 700 }}>校准</span>：Mid_Offset 读 50 次求平均，偏置存 Flash（ANO_Param_SAVE）。
        </Text>
      </Box>
      <Box style={{ background: '#0F1E33', borderLeft: '4px solid #4A90D9', padding: '12px 20px', borderRadius: 8, width: '48%' }}>
        <Text style={{ fontSize: 17, color: '#E8F0FA', lineHeight: 1.5 }}>
          <span style={{ color: '#4A90D9', fontWeight: 700 }}>死区</span>：Mid_Limit 把 ±10 内归中，避免摇杆微抖导致飞机漂移。
        </Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 60, padding: '0 64px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>飞控+遥控 代码讲解（30min）</Text>
    <Text style={{ fontSize: 14, color: '#7E94AE' }}>16 / 22</Text>
  </Box>
</Slide>
