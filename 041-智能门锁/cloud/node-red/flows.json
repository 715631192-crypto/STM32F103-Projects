  {
    "id": "sign-command",
    "type": "function",
    "z": "smartlock-tab",
    "name": "Validate and HMAC-sign",
    "func": "const crypto = global.get('crypto');\nconst deviceId = env.get('SMART_LOCK_DEVICE_ID');\nconst secretHex = env.get('SMART_LOCK_DEVICE_SECRET_HEX') || '';\nconst fail = (code,text) => { msg.statusCode=code; msg.payload={error:text}; return [null,msg]; };\nif (!/^[a-zA-Z0-9_-]{1,48}$/.test(deviceId || '')) return fail(500,'invalid server device id');\nif (!/^[0-9a-fA-F]{64}$/.test(secretHex)) return fail(500,'device secret is not configured');\nlet actionName = msg.visitorRequest ? 'visitor' : String((msg.payload||{}).action||'');\nconst actions={unlock:1,lock:2,clear_lockout:3,visitor:4};\nif (!actions[actionName]) return fail(400,'unsupported action');\nconst now=Math.floor(Date.now()/1000);\nlet expires=now+30, visitor='', uses=0;\nif(actionName==='visitor'){const minutes=Math.max(1,Math.min(60,Number(msg.payload.minutes)||5));uses=Math.max(1,Math.min(5,Number(msg.payload.uses)||1));expires=now+minutes*60;visitor=String(crypto.randomInt(0,1000000)).padStart(6,'0');}\nlet requestId=Math.max(Number(flow.get('last_request_id')||0)+1,Date.now());flow.set('last_request_id',requestId);\nconst canonical=Buffer.alloc(39);canonical.writeBigUInt64BE(BigInt(requestId),0);canonical.writeBigUInt64BE(BigInt(now),8);canonical.writeBigUInt64BE(BigInt(expires),16);canonical[24]=actions[actionName];canonical.write(visitor,25,12,'ascii');canonical[37]=visitor.length;canonical[38]=uses;\nconst tag=crypto.createHmac('sha1',Buffer.from(secretHex,'hex')).update(canonical).digest('hex');\nconst body={request_id:requestId,issued_at:now,expires_at:expires,action:actions[actionName],visitor_code:visitor,visitor_code_length:visitor.length,visitor_uses:uses,authentication_tag:tag};\nconst mqtt={topic:`smartlock/${deviceId}/command`,qos:'1',retain:false,payload:JSON.stringify(body)};\nmsg.statusCode=202;msg.payload={accepted:true,request_id:requestId,visitor_code:visitor||undefined,expires_at:expires};\nreturn [mqtt,msg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 430,
    "wires": [["commands-out"],["command-http-out"]]
  },
