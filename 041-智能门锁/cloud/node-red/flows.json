  {
    "id": "cache-event",
    "type": "function",
    "z": "smartlock-tab",
    "name": "Validate and cache",
    "func": "let value = msg.payload;\nif (Buffer.isBuffer(value)) value = value.toString('utf8');\nif (typeof value === 'string') { try { value = JSON.parse(value); } catch (e) { return null; } }\nif (!value || typeof value !== 'object') return null;\nconst item = { received_at: Math.floor(Date.now()/1000), topic: msg.topic, data: value };\nlet events = flow.get('events') || [];\nevents.unshift(item);\nflow.set('events', events.slice(0, 100));\nif (msg.topic.endsWith('/state')) flow.set('latest_state', item);\nconst webhook = env.get('SMART_LOCK_ALERT_WEBHOOK_URL') || '';\nif (!msg.topic.endsWith('/state') && [6,7,9].includes(Number(value.event_type)) && /^https:\\/\\//.test(webhook)) { msg.url=webhook; msg.method='POST'; msg.headers={'content-type':'application/json'}; msg.payload={source:'smart-lock',alert:item}; return msg; }\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 100,
    "wires": [["alert-webhook"]]
  },
  {
    "id": "alert-webhook",
    "type": "http request",
    "z": "smartlock-tab",
    "name": "Emergency alert webhook",
    "method": "use",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 650,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "home-in",
    "type": "http in",
    "z": "smartlock-tab",
    "name": "Dashboard",
    "url": "/",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 120,
    "y": 220,
    "wires": [["home-html"]]
  },
  {
    "id": "home-html",
    "type": "template",
    "z": "smartlock-tab",
    "name": "Minimal mobile UI",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!doctype html><html lang=\"zh-CN\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>智能门锁</title><style>body{font:16px system-ui;max-width:560px;margin:2rem auto;padding:0 1rem;background:#f4f6f8;color:#18212b}section{background:white;padding:1.2rem;border-radius:14px;box-shadow:0 2px 12px #0001;margin-bottom:1rem}button{padding:.8rem 1.1rem;margin:.25rem;border:0;border-radius:9px;background:#1664d9;color:white;font-size:1rem}button.lock{background:#384453}button.warn{background:#a05200}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style><h1>智能门锁 MVP</h1><section><button onclick=\"cmd('unlock')\">远程开锁</button><button class=\"lock\" onclick=\"cmd('lock')\">立即落锁</button><button class=\"warn\" onclick=\"cmd('clear_lockout')\">解除锁定</button><button onclick=\"visitor()\">生成访客码</button><p id=\"result\"></p></section><section><h2>最近状态</h2><pre id=\"state\">加载中…</pre></section><section><h2>最近事件</h2><pre id=\"events\"></pre></section><script>async function post(path,body){const r=await fetch(path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body||{})});const j=await r.json();if(!r.ok)throw Error(j.error||r.statusText);return j}async function cmd(action){try{result.textContent=JSON.stringify(await post('/api/command',{action}))}catch(e){result.textContent=e.message}}async function visitor(){try{result.textContent='访客码：'+(await post('/api/visitor',{minutes:5,uses:1})).visitor_code}catch(e){result.textContent=e.message}}async function refresh(){try{state.textContent=JSON.stringify(await (await fetch('/api/status')).json(),null,2);events.textContent=JSON.stringify(await (await fetch('/api/events')).json(),null,2)}catch(e){state.textContent=e.message}}refresh();setInterval(refresh,3000)</script></html>",
    "output": "str",
    "x": 340,
    "y": 220,
    "wires": [["home-out"]]
  },
