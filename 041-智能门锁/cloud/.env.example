TZ=Asia/Shanghai
SMART_LOCK_DEVICE_ID=door-001
# Exactly 64 hexadecimal characters (32 random bytes); provision the same value to the lock.
SMART_LOCK_DEVICE_SECRET_HEX=replace_with_64_random_hex_characters
# Used by Node-RED to encrypt stored credentials; use a separate random value.
NODE_RED_CREDENTIAL_SECRET=replace_with_another_random_value
NODE_RED_UI_USER=admin
# Generate with: docker run --rm -it nodered/node-red:4 node-red admin hash-pw
# Keep the bcrypt hash in single quotes so Docker Compose preserves dollar signs.
NODE_RED_UI_PASSWORD_HASH='replace_with_bcrypt_hash'
# Optional HTTPS webhook for tamper, door-ajar, and duress alerts.
SMART_LOCK_ALERT_WEBHOOK_URL=
